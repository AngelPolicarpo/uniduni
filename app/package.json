{
  "name": "@comunidade/app",
  "version": "0.0.0",
  "private": true,
  "description": "Shell Electron do produto — main + utilityProcess + renderer (§3.1)",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "electron .",
    "montar": "node scripts/montar.mjs",
    "smoke:fechamento": "node scripts/smoke-fechamento.mjs",
    "smoke:captura": "node scripts/smoke-captura.mjs",
    "smoke:clipboard": "node scripts/smoke-clipboard.mjs",
    "smoke:token": "node scripts/smoke-token.mjs",
    "smoke:deeplink": "node scripts/smoke-deeplink.mjs",
    "dist": "npm run montar && electron-builder --config electron-builder.json --publish never",
    "dist:win": "npm run montar && electron-builder --config electron-builder.json --win --publish never",
    "dist:linux": "npm run montar && electron-builder --config electron-builder.json --linux --publish never",
    "smoke:voz": "node scripts/smoke-voz.mjs",
    "smoke:tela": "node scripts/smoke-tela.mjs"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "better-sqlite3": "13.0.3",
    "compact-encoding": "^2.16.1",
    "corestore": "7.12.0",
    "fs-native-extensions": "1.5.0",
    "hypercore": "11.35.1",
    "hyperswarm": "^4.17.0",
    "protomux": "^3.11.0",
    "sodium-native": "5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.8.3"
  },
  "author": "Comunidade P2P"
}
