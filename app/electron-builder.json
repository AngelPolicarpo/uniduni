{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "br.uniduni.app",
  "productName": "Uniduni",
  "executableName": "uniduni",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "!**/node_modules/*/{prebuilds,build}/**/android*",
    "!**/node_modules/*/{prebuilds,build}/**/ios*",
    "!**/node_modules/*/{prebuilds,build}/**/darwin*",
    "!**/node_modules/*/{prebuilds,build}/**/win32-arm64*",
    "!**/node_modules/*/{prebuilds,build}/**/linux-arm*",
    "!**/node_modules/*/{prebuilds,build}/**/linuxmusl*",
    "!**/node_modules/better-sqlite3/prebuilds/darwin*",
    "!**/node_modules/better-sqlite3/prebuilds/*arm64*",
    "!**/node_modules/better-sqlite3/prebuilds/linuxmusl*",
    "!**/node_modules/better-sqlite3/deps/**"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**",
    "**/node_modules/sodium-native/**",
    "**/node_modules/fs-native-extensions/**"
  ],
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "protocols": [
    {
      "name": "Uniduni",
      "schemes": ["comunidadep2p"]
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "AngelPolicarpo",
    "repo": "uniduni",
    "releaseType": "release"
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "artifactName": "Uniduni-${version}-windows-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Uniduni-${version}-windows-${arch}-instalador.${ext}"
  },
  "portable": {
    "artifactName": "Uniduni-${version}-windows-${arch}-portable.${ext}"
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "Uniduni-${version}-linux-${arch}.${ext}",
    "category": "Network"
  }
}
